# ==============================================================================
# Twenty CRM - Production Environment Configuration (Example Template)
# ==============================================================================

DOCKER_IMAGE=ghcr.io/thewaqaspro/twenty
TAG=latest
NODE_ENV=production
PORT=3000
NODE_PORT=3000
SERVER_URL=https://crm.kyndstudio.com
FRONT_AUTO_BASE_URL=true
FRONT_BASE_URL=https://crm.kyndstudio.com

# Container Memory & Heap Sizing (Multi-Client Ready)
SERVER_MEMORY_LIMIT=2560M
SERVER_MAX_OLD_SPACE_SIZE=2048
WORKER_MEMORY_LIMIT=1280M
WORKER_MAX_OLD_SPACE_SIZE=1024
BACKUP_KEEP_DAYS=14

# Workspace Isolation Mode (Set IS_MULTIWORKSPACE_ENABLED=true for subdomain multi-client mode)
IS_MULTIWORKSPACE_ENABLED=true
DEFAULT_SUBDOMAIN=app
IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=true
IS_CONFIG_VARIABLES_IN_DB_ENABLED=true
MAX_WORKSPACES_WITHOUT_ENTERPRISE_KEY=100

# CRITICAL: Escrow these in 1Password/Bitwarden! Losing them breaks encrypted DB tokens.
APP_SECRET=your_32_byte_base64_secret
ENCRYPTION_KEY=your_32_byte_base64_encryption_key

PG_DATABASE_URL=postgresql://user:password@host:5432/dbname
REDIS_URL=redis://default:password@host:6379/3

STORAGE_TYPE=s3
STORAGE_S3_NAME=crm-kyndstudio
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT=https://s3.kyndstudio.com
STORAGE_S3_ACCESS_KEY_ID=your_access_key
STORAGE_S3_SECRET_ACCESS_KEY=your_secret_key
STORAGE_S3_PRESIGNED_URL_ENABLED=true
STORAGE_S3_PRESIGNED_URL_BASE=https://s3.kyndstudio.com

EMAIL_DRIVER=smtp
EMAIL_FROM_ADDRESS=hello@waqas.pro
EMAIL_FROM_NAME="Waqas"
EMAIL_SMTP_HOST=smtp-relay.brevo.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=thewaqaspro@gmail.com
EMAIL_SMTP_PASSWORD=your_smtp_key
